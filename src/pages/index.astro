---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/HomePage';
---

<BaseLayout title="CSS Animation Library">
  {/* Hero section */}
  <div class="mb-6 md:mb-10">
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-text-primary font-heading mb-2 md:mb-3">
      CSS Animation <span class="text-tech-blue">Library</span>
    </h1>
    <p class="text-text-muted text-sm sm:text-base max-w-2xl leading-relaxed">
      Browse, customize, and copy-paste beautiful CSS animations.
      <span class="text-neon-green font-medium">Zero dependencies. Pure CSS + HTML.</span>
    </p>
  </div>

  <HomePage client:only="react" />
</BaseLayout>
